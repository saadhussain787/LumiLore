{
  "name": "lumilore",
  "version": "1.0.0",
  "scripts": {
    "build:css": "npx @tailwindcss/cli -i ./frontend/input.css -o ./_site/style.css --minify",
    "watch:css": "npx @tailwindcss/cli -i ./frontend/input.css -o ./frontend/style.css --watch",
    "build": "npx @tailwindcss/cli -i ./frontend/input.css -o ./frontend/style.css --minify && npx @11ty/eleventy",
    "start": "npx @11ty/eleventy --serve",
    "fleet:status": "node agents/agency-fleet/run-fleet.js --status",
    "fleet:run": "node agents/agency-fleet/run-fleet.js",
    "fleet:growth": "node agents/agency-fleet/run-fleet.js --division=growth",
    "fleet:growth:dry": "node agents/agency-fleet/run-fleet.js --division=growth --dry-run",
    "fleet:sales": "node agents/agency-fleet/run-fleet.js --division=sales",
    "fleet:sales:dry": "node agents/agency-fleet/run-fleet.js --division=sales --dry-run",
    "geo:run": "node agents/seo-geo-agent/run.js",
    "geo:run:dry": "node agents/seo-geo-agent/run.js --dry-run",
    "seo:cron": "node agents/seo-geo-agent/run.js --cron --all",
    "seo:radar": "node agents/seo-geo-agent/run.js --radar",
    "test:seo": "node scratch/run_full_sprint11_suite.js",
    "marketing:run": "node agents/marketing-agent/run.js --all",
    "marketing:run:dry": "node agents/marketing-agent/run.js --all --dry-run",
    "marketing:linkedin": "node agents/marketing-agent/run.js --linkedin",
    "marketing:twitter": "node agents/marketing-agent/run.js --twitter",
    "marketing:radar": "node agents/marketing-agent/run.js --radar",
    "marketing:syndicate": "node agents/marketing-agent/run.js --syndicate",
    "marketing:gbp": "node agents/marketing-agent/run.js --gbp",
    "marketing:outreach": "node agents/marketing-agent/run.js --outreach",
    "marketing:audit": "node agents/marketing-agent/run.js --audit",
    "marketing:scout": "node agents/marketing-agent/run.js --scout"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "@tailwindcss/cli": "^4.0.0",
    "tailwindcss": "^4.0.0"
  }
}
